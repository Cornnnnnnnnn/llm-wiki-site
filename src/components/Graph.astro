---
import Shell from './Shell.astro';
import Icon from './Icon.astro';
import {ui,type Locale} from '../i18n/ui';
import {catalog,publicRelations,href} from '../lib/catalog';
const {locale='zh-Hant'}=Astro.props as {locale:Locale};const t=ui[locale];const prefix=locale==='en'?'en/':'';
const entries=await catalog();const edges=publicRelations(entries);
const positions=new Map(entries.map((e,i)=>{const angle=i/Math.max(1,entries.length)*Math.PI*2-Math.PI/2;return [e.id,{x:entries.length===1?400:400+Math.cos(angle)*260,y:entries.length===1?240:240+Math.sin(angle)*170}]}));
const title=(id:string)=>entries.find(e=>e.id===id)?.data.title||'';
---
<Shell locale={locale} page="graph" title={`${t.graph} · LLM Wiki`}>
<section class="page-intro container"><p class="eyebrow">THE KNOWLEDGE GRAPH</p><h1>{t.graphTitle}</h1><p>{t.graphIntro}</p></section>
<section class="container"><div class="graph-panel">
{entries.length?<><div class="graph-tools"><button data-zoom="in" aria-label={t.zoomIn}>+</button><button data-zoom="out" aria-label={t.zoomOut}>−</button><button data-zoom="reset">{t.graphReset}</button></div><svg class="graph-svg" viewBox="0 0 800 480" role="img" aria-label={t.graph}><g id="graph-content">{edges.map(edge=><line x1={positions.get(edge.source)!.x} y1={positions.get(edge.source)!.y} x2={positions.get(edge.target)!.x} y2={positions.get(edge.target)!.y}/>)}{entries.map(e=><a href={href(prefix+`articles/${e.id}/`)} aria-label={e.data.title}><title>{e.data.title}</title><circle cx={positions.get(e.id)!.x} cy={positions.get(e.id)!.y} r="13"/><text x={positions.get(e.id)!.x} y={positions.get(e.id)!.y+34} text-anchor="middle">{e.data.title.length>22?e.data.title.slice(0,21)+'…':e.data.title}</text></a>)}</g></svg></>:<div class="empty-state"><div class="empty-icon"><Icon name="graph" size={29}/></div><h2>{t.graphEmpty}</h2><p>{t.graphHint}</p><a class="text-link" href={href(prefix)}>{t.back}<span>→</span></a></div>}
</div><div class="relations"><h2>{t.relations} <span class="count">{edges.length}</span></h2>{edges.length?<ul>{edges.map(edge=><li><a href={href(prefix+`articles/${edge.source}/`)}>{title(edge.source)}</a> ↔ <a href={href(prefix+`articles/${edge.target}/`)}>{title(edge.target)}</a></li>)}</ul>:<p class="reader-meta">{t.graphHint}</p>}</div></section>
<script>
const svg=document.querySelector<SVGSVGElement>('.graph-svg');const g=document.querySelector<SVGGElement>('#graph-content');
let scale=1,x=0,y=0;let drag:{x:number,y:number}|undefined;
const draw=()=>g?.setAttribute('transform',`translate(${400+x} ${240+y}) scale(${scale}) translate(-400 -240)`);
document.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach(button=>button.addEventListener('click',()=>{if(button.dataset.zoom==='reset'){scale=1;x=y=0}else scale=Math.min(3,Math.max(.4,scale*(button.dataset.zoom==='in'?1.2:1/1.2)));draw()}));
svg?.addEventListener('pointerdown',e=>{if((e.target as Element).closest('a'))return;drag={x:e.clientX,y:e.clientY};svg.setPointerCapture(e.pointerId)});
svg?.addEventListener('pointermove',e=>{if(!drag)return;const ratio=800/svg.getBoundingClientRect().width;x+=(e.clientX-drag.x)*ratio;y+=(e.clientY-drag.y)*ratio;drag={x:e.clientX,y:e.clientY};draw()});
svg?.addEventListener('pointerup',()=>drag=undefined);svg?.addEventListener('pointercancel',()=>drag=undefined);
</script>
</Shell>
