---
import Shell from './Shell.astro';
import Icon from './Icon.astro';
import {ui,type Locale} from '../i18n/ui';
import {catalog,publicRelations,href} from '../lib/catalog';
const {locale='zh-Hant'}=Astro.props as {locale:Locale}; const t=ui[locale]; const prefix=locale==='en'?'en/':'';
const entries=await catalog();const subjects=[...new Set(entries.map(e=>e.data.subject))];const tags=[...new Set(entries.flatMap(e=>e.data.tags))];
const types={'handwritten-note':t.handwritten,paper:t.paper,'digital-note':t.digital};
---
<Shell locale={locale}>
<section class="hero container">
 <div class="hero-copy"><p class="eyebrow"><span class="status-dot"></span> {t.eyebrow}</p><h1>{t.title}</h1><p class="intro">{t.intro}</p><div class="hero-actions"><a class="button primary" href="#collection">{t.browse}<Icon name="arrow" size={17}/></a><a class="text-link" href={href(prefix+'graph/')}>{t.explore}<span>→</span></a></div><div class="hero-note">A LIVING COLLECTION OF IDEAS <span>—</span> EST. 2026</div></div>
 <div class="hero-art" aria-hidden="true"><div class="art-grid"></div><svg viewBox="0 0 440 310" fill="none"><path d="M95 95C155 45 289 52 340 144M90 200C165 267 287 260 340 144M95 95 210 155 90 200M210 155 340 144M210 155 262 263" stroke="currentColor" stroke-dasharray="4 5" opacity=".28"/><circle cx="210" cy="155" r="77" stroke="currentColor" opacity=".12"/><circle cx="210" cy="155" r="115" stroke="currentColor" opacity=".08"/><g class="art-card"><rect x="161" y="106" width="100" height="100" rx="13"/><path d="M189 135h16a7 7 0 0 1 7 7v37a12 12 0 0 0-11-7h-12zm23 7a7 7 0 0 1 7-7h15v37h-11a12 12 0 0 0-11 7" stroke="currentColor" stroke-width="1.5"/></g><g class="art-card"><rect x="59" y="61" width="66" height="66" rx="10"/><text x="78" y="104" font-family="Georgia" font-size="28" fill="currentColor">∑</text><rect x="309" y="114" width="66" height="66" rx="10"/><path d="M331 132h16l8 8v24h-24zM347 132v9h8M336 147h13m-13 6h13" stroke="currentColor" stroke-width="1.5"/><rect x="61" y="177" width="55" height="55" rx="10"/><text x="78" y="214" font-family="Georgia" font-style="italic" font-size="25" fill="currentColor">λ</text></g><circle cx="262" cy="263" r="5" fill="currentColor"/><circle cx="301" cy="57" r="3" fill="currentColor" opacity=".25"/></svg><span class="art-caption">CAPTURE. UNDERSTAND. CONNECT.</span></div>
</section>
<section class="stats container" aria-label={t.library}><div><strong>{String(entries.length).padStart(2,'0')}</strong><span>{t.articles}</span></div><div><strong>{String(subjects.length).padStart(2,'0')}</strong><span>{t.subjects}</span></div><div><strong>{String(publicRelations(entries).length).padStart(2,'0')}</strong><span>{t.connections}</span></div><span class="stats-end">THINK IN CONNECTIONS <Icon name="graph"/></span></section>
<section id="collection" class="collection container" data-count={entries.length} data-error={t.searchError} data-base={href('')}>
<div class="section-heading"><div><p class="eyebrow">THE COLLECTION</p><h2>{t.collection}<span class="count">{entries.length}</span></h2><p>{t.collectionSub}</p></div><span class="section-number">01 / LIBRARY</span></div>
<div class="filters"><label class="search"><Icon name="search"/><span class="sr-only">{t.search}</span><input id="search" type="search" placeholder={t.search}/><kbd>/</kbd></label><label><span class="sr-only">{t.all}</span><select id="type"><option value="">{t.all}</option>{Object.entries(types).map(([v,label])=><option value={v}>{label}</option>)}</select></label><label><span class="sr-only">{t.subject}</span><select id="subject"><option value="">{t.subject}</option>{subjects.map(s=><option>{s}</option>)}</select></label><label><span class="sr-only">{t.tag}</span><select id="tag"><option value="">{t.tag}</option>{tags.map(s=><option>{s}</option>)}</select></label></div>
<p id="search-status" class="search-status" role="status" aria-live="polite"></p>
{entries.length===0?<div class="empty-state"><div class="empty-icon"><Icon name="book" size={31}/><span>+</span></div><h3>{t.empty}</h3><p>{t.emptyText}</p><a class="text-link" href={href(prefix+'guide/')}>{t.how}<span>→</span></a></div>:<><div class="article-grid">{entries.map(e=><article class="article-card" data-id={e.id} data-type={e.data.type} data-subject={e.data.subject} data-tags={JSON.stringify(e.data.tags)} data-search={[e.data.title,e.data.summary,...e.data.tags,e.data.subject].join(' ').toLowerCase()}><div class="card-top"><span class="type-label"><Icon name={e.data.type==='paper'?'file':'book'} size={16}/>{types[e.data.type]}</span><span>{e.data.language}</span></div><h3><a href={href(prefix+`articles/${e.id}/`)}>{e.data.title}</a></h3><p>{e.data.summary}</p><div class="tags">{e.data.tags.map(tag=><span>#{tag}</span>)}</div><div class="card-bottom"><span>{e.data.subject}</span><a href={href(prefix+`articles/${e.id}/`)} aria-label={`${t.read}: ${e.data.title}`}><Icon name="arrow"/></a></div></article>)}</div><div id="no-results" class="empty-state" hidden><Icon name="search" size={30}/><h3>{t.noResults}</h3><button class="button" id="reset">{t.reset}</button></div></>}
</section>
<section class="workflow container"><div class="workflow-heading"><p class="eyebrow">A THOUGHTFUL PROCESS</p><h2>{t.workflow}<span>↗</span></h2></div><div class="process-grid">{[[t.step1,t.desc1,'file'],[t.step2,t.desc2,'check'],[t.step3,t.desc3,'graph']].map(([title,desc,icon],i)=><div class="process-card"><span class="step-number">0{i+1}</span><Icon name={icon}/><h3>{title}</h3><p>{desc}</p></div>)}</div></section>
<script src="../scripts/library.ts"></script>
</Shell>
